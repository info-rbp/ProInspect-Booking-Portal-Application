{
  "name": "proinspect-booking-portal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "start": "tsx server.ts",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "container:build": "docker build -t proinspect-booking-portal .",
    "test:e2e:booking": "node scripts/e2e-booking-smoke.mjs",
    "migrate:portal:dry": "tsx scripts/migrate-unified-portal.ts",
    "migrate:portal": "tsx scripts/migrate-unified-portal.ts --apply",
    "test:e2e:portal-security": "node scripts/e2e-portal-security.mjs",
    "freeze:check": "node scripts/premerge-freeze-check.mjs",
    "test:migration-preflight": "tsx scripts/verify-tenant-migration-preflight.ts",
    "stage2:check": "node scripts/stage2-integration-check.mjs",
    "stage3:test": "node --import tsx --test scripts/stage3/tests/*.test.ts",
    "stage3:check": "python3 scripts/stage3/control.py check-repository",
    "stage3:test:controls": "python3 -m unittest discover -s scripts/stage3/tests -p 'test_*.py' -v",
    "stage4:check": "python3 scripts/stage4/check.py",
    "stage4:test:controls": "python3 -m unittest discover -s scripts/stage4/tests -p 'test_*.py' -v",
    "stage4:test": "node --import tsx --test scripts/stage4/tests/*.test.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "firebase-admin": "^13.5.0",
    "google-auth-library": "^10.3.0",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  },
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22 <23"
  }
}
