{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "proinspect-booking-portal",
  "account_id": "8ca23ac6d2cc906d4dd13b8da5ea2b25",
  "main": "src/cloudflare.ts",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "ProInspectContainer",
      "image": "./Dockerfile",
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PROINSPECT_CONTAINER",
        "class_name": "ProInspectContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ProInspectContainer"
      ]
    }
  ]
}
