# ProInspect Booking Portal server configuration
#
# In Google AI Studio, add sensitive values through the Secrets panel rather
# than committing them to GitHub. Cloud Run can also provide these variables
# through Secret Manager / service configuration.

APP_URL="http://localhost:3000"

# Firebase Admin
# Cloud Run can normally use Application Default Credentials.
# For AI Studio/local development where ADC is unavailable, provide a
# service-account JSON value as a server-side secret.
FIREBASE_PROJECT_ID="business-plan-applicatio-17047"
FIRESTORE_DATABASE_ID="ai-studio-7242850f-c156-4268-aeb7-c8d47ff6931a"
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Administrator allow-list.
# These are checked in addition to adminUsers/{firebaseUid} records in Firestore.
ADMIN_EMAILS="info@proinspect.systems,info@remotebusinesspartner.com.au"

# Dedicated ProInspect Google Calendar.
# The Calendar API must be enabled in the Google Cloud project.
# Share this calendar with the service account used by the server, unless the
# Cloud Run runtime identity already has Calendar access through your Workspace configuration.
GOOGLE_CALENDAR_ID=""

# Optional explicit Calendar service-account credentials.
# If omitted, google-auth-library uses Application Default Credentials.
GOOGLE_CALENDAR_SERVICE_ACCOUNT_JSON=""
