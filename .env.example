# ProInspect Booking Portal server configuration
#
# Production target: Google Cloud Run.
# Cloud Run production uses the assigned runtime service account through
# Application Default Credentials (ADC). Do not configure long-lived Firebase
# or Calendar service-account JSON keys in the Cloud Run service.

APP_URL="http://localhost:3000"

# Firebase / Firestore
FIREBASE_PROJECT_ID="business-plan-applicatio-17047"
FIRESTORE_DATABASE_ID="ai-studio-7242850f-c156-4268-aeb7-c8d47ff6931a"
FIREBASE_STORAGE_BUCKET="business-plan-applicatio-17047.firebasestorage.app"

# Optional local-development fallback only.
# Leave unset in Cloud Run so Firebase Admin uses Application Default Credentials.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Administrator allow-list.
ADMIN_EMAILS="info@proinspect.systems,info@remotebusinesspartner.com.au"

# Dedicated ProInspect Google Calendar.
GOOGLE_CALENDAR_ID="c_4bf5fc54ee54bf60371059cf824ec7e018fb6c43ca66bbdd4051fafaa74e3c32@group.calendar.google.com"

# Optional local-development fallback only.
# Leave unset in Cloud Run so google-auth-library uses Application Default Credentials.
GOOGLE_CALENDAR_SERVICE_ACCOUNT_JSON=""

# Google Maps Platform address verification.
# Modes:
# - off: do not call Google address services
# - optional: verify when available but do not fail bookings on API/config outages
# - required: every booking must pass Google Address Validation
ADDRESS_VALIDATION_MODE="optional"

# Optional API-key fallback for Google Places / Address Validation.
# Cloud Run can use ADC; if using a key, store it as a Cloud Run secret and
# restrict it to only the required Google Maps Platform APIs.
GOOGLE_MAPS_API_KEY=""

# Sensitive property-access encryption.
# Generate a random 32-byte key and store the base64 value in Secret Manager.
# Example generation command: openssl rand -base64 32
ACCESS_DATA_ENCRYPTION_KEY=""
ACCESS_DATA_ENCRYPTION_KEY_ID="v1"

# Booking confirmation email via Resend.
# Store RESEND_API_KEY in Secret Manager. The sending domain/address must be
# verified with the email provider before production delivery.
RESEND_API_KEY=""
BOOKING_EMAIL_FROM="ProInspect <bookings@proinspect.systems>"
BOOKING_EMAIL_REPLY_TO="info@proinspect.systems"

# Optional public brand asset URL used by the React header/footer.
VITE_PROINSPECT_LOGO_URL=""


# Tenant portal email notifications.
# Defaults to BOOKING_EMAIL_FROM / BOOKING_EMAIL_REPLY_TO when left blank.
TENANT_EMAIL_FROM=""
TENANT_EMAIL_REPLY_TO=""


# Unified platform integrations
# Random high-entropy token used by the Property Report Tool when posting final
# reports to POST /api/integrations/reports.
REPORT_INGEST_TOKEN=""

# Property Report Tool launch URL and short-lived handoff signing key.
# The same signing key is configured as PROINSPECT_HANDOFF_SIGNING_KEY in the
# Property Report Tool Worker. Do not expose either key to browser code.
REPORT_TOOL_URL="https://report.creation.proinspect.systems/"
REPORT_HANDOFF_SIGNING_KEY=""

# Optional external checkout adapter. Use placeholders supported by the server:
# {paymentId}, {reference}, {totalAmount}
# Example:
# PAYMENT_CHECKOUT_URL_TEMPLATE="https://checkout.example.com/pay?payment={paymentId}&ref={reference}&amount={totalAmount}"
PAYMENT_CHECKOUT_URL_TEMPLATE=""

# Random token required by POST /api/integrations/payments/:id/status.
PAYMENT_WEBHOOK_TOKEN=""
