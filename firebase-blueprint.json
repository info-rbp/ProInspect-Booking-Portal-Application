  "firestore": {
    "/services/{serviceId}": {
      "schema": "Service",
      "description": "Inspection and field-service definitions used by the booking engine."
    },
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Persistent customer bookings and internal work orders."
    },
    "/clientUsers/{firebaseUid}": {
      "schema": "ClientUser",
      "description": "Verified client identity and profile record."
    },
    "/clientOrganisations/{organisationId}": {
      "schema": "ClientOrganisation",
      "description": "Client entity used to group properties, users, requests and documents."
    },
    "/clientMemberships/{membershipId}": {
      "schema": "ClientMembership",
      "description": "Role-based client user membership and invitation record."
    },
    "/clientProperties/{propertyId}": {
      "schema": "ClientProperty",
      "description": "Properties linked to authenticated client accounts."
    },
    "/clientRequests/{requestId}": {
      "schema": "ClientRequest",
      "description": "Client request records used by future document and property-operation workflows."
    },
    "/clientDocuments/{documentId}": {
      "schema": "ClientDocument",
      "description": "Client-visible metadata for uploaded and generated files stored in Firebase Storage."
    },
    "/clientApprovals/{approvalId}": {
      "schema": "ClientApproval",
      "description": "Recorded client approvals and requested changes."
    },
    "/settings/business": {
      "schema": "Settings",
      "description": "Single business scheduling configuration record."
    },
    "/adminUsers/{firebaseUid}": {
      "schema": "AdminUser",
      "description": "Optional Firebase UID based administrator allow-list."
    },
    "/scheduleLocks/{lockId}": {
      "schema": "ScheduleLock",
      "description": "Internal transient concurrency locks. Server-only; never exposed to the browser."
    },
    "/bookingAccessSecrets/{bookingId}": {
      "schema": "BookingAccessSecret",
      "description": "Encrypted sensitive property-access credentials. Server-only; never exposed through public booking APIs or Google Calendar."
    },
    "/documentProducts/{documentId}": {
      "schema": "DocumentProduct",
      "description": "Document catalogue available through Request a Document."
    },
    "/documentRequests/{requestId}": {
      "schema": "DocumentRequest",
      "description": "Customer document requests created by the trusted server API."
    }
  },
  "security": {
    "clientFirestoreAccess": "denied",
    "trustedServerAccess": "Firebase Admin SDK",
    "adminAuthentication": "Firebase Authentication ID token verified by Express server",
    "sensitiveAccessStorage": "AES-256-GCM encrypted bookingAccessSecrets collection; authenticated staff API only"
  }
}
