{
  "entities": {
    "Service": {
      "title": "Service",
      "description": "ProInspect bookable service configuration. Firestore is the runtime source of truth; defaults seed missing records only.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "publicDescription": {
          "type": "string",
          "maxLength": 500
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "residential",
              "commercial",
              "strata-building"
            ]
          },
          "minItems": 1
        },
        "duration": {
          "type": "number"
        },
        "bufferBefore": {
          "type": "number"
        },
        "bufferAfter": {
          "type": "number"
        },
        "minimumNoticeHours": {
          "type": "number"
        },
        "maxFutureBookingDays": {
          "type": "number"
        },
        "calendarId": {
          "type": "string",
          "maxLength": 256
        },
        "active": {
          "type": "boolean"
        },
        "publiclyBookable": {
          "type": "boolean"
        },
        "order": {
          "type": "number"
        },
        "iconName": {
          "type": "string",
          "maxLength": 64
        },
        "badge": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": [
        "name",
        "categories",
        "duration",
        "active",
        "publiclyBookable"
      ]
    },
    "Booking": {
      "title": "Booking",
      "description": "Persistent booking/work-order record created by the trusted server API.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "bookingReference": {
          "type": "string",
          "maxLength": 32
        },
        "managementToken": {
          "type": "string",
          "maxLength": 128
        },
        "serviceId": {
          "type": "string",
          "maxLength": 64
        },
        "serviceName": {
          "type": "string",
          "maxLength": 100
        },
        "serviceCategory": {
          "type": "string",
          "enum": [
            "residential",
            "commercial",
            "strata-building"
          ]
        },
        "calendarEventId": {
          "type": "string",
          "maxLength": 256
        },
        "calendarHtmlLink": {
          "type": "string",
          "maxLength": 1000
        },
        "property": {
          "type": "object"
        },
        "access": {
          "type": "object"
        },
        "appointment": {
          "type": "object"
        },
        "status": {
          "type": "string",
          "enum": [
            "confirmed",
            "completed",
            "cancelled"
          ]
        },
        "adminNotes": {
          "type": "string",
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string",
          "maxLength": 50
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 50
        },
        "readinessStatus": {
          "type": "string",
          "enum": [
            "ready",
            "pending_notice",
            "access_action_required"
          ]
        },
        "confirmationEmail": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "bookingReference",
        "managementToken",
        "serviceId",
        "serviceName",
        "serviceCategory",
        "property",
        "access",
        "appointment",
        "readinessStatus",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "Settings": {
      "title": "Settings",
      "description": "ProInspect scheduling and operating configuration stored at settings/business.",
      "type": "object",
      "properties": {
        "timezone": {
          "type": "string",
          "maxLength": 50
        },
        "locale": {
          "type": "string",
          "maxLength": 20
        },
        "operatingHours": {
          "type": "object"
        },
        "minimumNoticeHours": {
          "type": "number"
        },
        "maxFutureBookingDays": {
          "type": "number"
        },
        "calendarConnected": {
          "type": "boolean"
        },
        "calendarEmail": {
          "type": "string",
          "maxLength": 256
        }
      },
      "required": [
        "timezone",
        "locale",
        "operatingHours"
      ]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Optional Firebase UID based administrator allow-list entry.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "maxLength": 50
        },
        "active": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "maxLength": 50
        }
      },
      "required": [
        "email"
      ]
    },
    "ScheduleLock": {
      "title": "ScheduleLock",
      "description": "Short-lived internal Firestore lock used to prevent concurrent booking confirmations from reserving overlapping times.",
      "type": "object",
      "properties": {
        "bookingId": {
          "type": "string",
          "maxLength": 128
        },
        "expiresAt": {
          "type": "string",
          "maxLength": 50
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 50
        }
      },
      "required": [
        "bookingId",
        "expiresAt",
        "updatedAt"
      ]
    },
    "BookingAccessSecret": {
      "title": "BookingAccessSecret",
      "description": "AES-256-GCM encrypted lockbox/alarm payload stored separately from the normal booking record. Server-only and decrypted only for authenticated staff responses.",
      "type": "object",
      "properties": {
        "version": {
          "type": "number"
        },
        "algorithm": {
          "type": "string",
          "enum": [
            "aes-256-gcm"
          ]
        },
        "keyId": {
          "type": "string",
          "maxLength": 100
        },
        "iv": {
          "type": "string",
          "maxLength": 100
        },
        "authTag": {
          "type": "string",
          "maxLength": 100
        },
        "ciphertext": {
          "type": "string",
          "maxLength": 10000
        },
        "createdAt": {
          "type": "string",
          "maxLength": 50
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 50
        }
      },
      "required": [
        "version",
        "algorithm",
        "keyId",
        "iv",
        "authTag",
        "ciphertext",
        "createdAt",
        "updatedAt"
      ]
    },
    "DocumentProduct": {
      "title": "DocumentProduct",
      "description": "Publicly requestable document product configuration. Firestore is the runtime source of truth; defaults seed missing Residential tenancy forms.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 100
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "publicDescription": {
          "type": "string",
          "maxLength": 500
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "residential",
              "commercial",
              "strata-building"
            ]
          },
          "minItems": 1
        },
        "priceExGst": {
          "type": "number"
        },
        "active": {
          "type": "boolean"
        },
        "publiclyRequestable": {
          "type": "boolean"
        },
        "order": {
          "type": "number"
        },
        "formCode": {
          "type": "string",
          "maxLength": 50
        },
        "badge": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": [
        "name",
        "categories",
        "priceExGst",
        "active",
        "publiclyRequestable",
        "order"
      ]
    },
    "DocumentRequest": {
      "title": "DocumentRequest",
      "description": "Persistent customer document request submitted through the ProInspect Client Hub.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "requestReference": {
          "type": "string",
          "maxLength": 32
        },
        "documentId": {
          "type": "string",
          "maxLength": 100
        },
        "documentName": {
          "type": "string",
          "maxLength": 250
        },
        "documentCategory": {
          "type": "string",
          "enum": [
            "residential",
            "commercial",
            "strata-building"
          ]
        },
        "priceExGst": {
          "type": "number"
        },
        "details": {
          "type": "object"
        },
        "status": {
          "type": "string",
          "enum": [
            "submitted",
            "in_review",
            "completed",
            "cancelled"
          ]
        },
        "createdAt": {
          "type": "string",
          "maxLength": 50
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 50
        }
      },
      "required": [
        "id",
        "requestReference",
        "documentId",
        "documentName",
        "documentCategory",
        "priceExGst",
        "details",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminOperationalRecord": {
      "type": "object",
      "description": "Shared admin operational record used by client, property, tenancy, document, maintenance, communication and subscription modules.",
      "properties": {
        "name": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "active": {
          "type": "boolean"
        },
        "clientId": {
          "type": "string"
        },
        "propertyId": {
          "type": "string"
        },
        "tenantId": {
          "type": "string"
        },
        "assignedStaffId": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "archivedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "AdminAuditEvent": {
      "type": "object",
      "description": "Immutable audit trail entry for privileged staff actions.",
      "required": [
        "actorUid",
        "actorEmail",
        "action",
        "resourceType",
        "createdAt"
      ],
      "properties": {
        "actorUid": {
          "type": "string"
        },
        "actorEmail": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "resourceType": {
          "type": "string"
        },
        "resourceId": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "metadata": {
          "type": "object"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "firestore": {
    "/services/{serviceId}": {
      "schema": "Service",
      "description": "Inspection and field-service definitions used by the booking engine."
    },
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Persistent customer bookings and internal work orders."
    },
    "/settings/business": {
      "schema": "Settings",
      "description": "Single business scheduling configuration record."
    },
    "/adminUsers/{firebaseUid}": {
      "schema": "AdminUser",
      "description": "Staff access profile bound to a Firebase UID on first Google sign-in. Pre-authorised email records may temporarily use a generated document ID until binding."
    },
    "/scheduleLocks/{lockId}": {
      "schema": "ScheduleLock",
      "description": "Internal transient concurrency locks. Server-only; never exposed to the browser."
    },
    "/bookingAccessSecrets/{bookingId}": {
      "schema": "BookingAccessSecret",
      "description": "Encrypted sensitive property-access credentials. Server-only; never exposed through public booking APIs or Google Calendar."
    },
    "/documentProducts/{documentId}": {
      "schema": "DocumentProduct",
      "description": "Document catalogue available through Request a Document."
    },
    "/documentRequests/{requestId}": {
      "schema": "DocumentRequest",
      "description": "Customer document requests created by the trusted server API."
    },
    "/clients/{clientId}": {
      "schema": "AdminOperationalRecord",
      "description": "Client and organisation records shared by admin and client portal workflows."
    },
    "/properties/{propertyId}": {
      "schema": "AdminOperationalRecord",
      "description": "Canonical property records linking clients, bookings, tenants, documents and maintenance."
    },
    "/tenants/{tenantId}": {
      "schema": "AdminOperationalRecord",
      "description": "Tenant and occupant records linked to properties."
    },
    "/propertyDocuments/{documentId}": {
      "schema": "AdminOperationalRecord",
      "description": "Generated, reviewed and issued property documents and reports."
    },
    "/maintenanceRequests/{requestId}": {
      "schema": "AdminOperationalRecord",
      "description": "Property maintenance requests, approvals, assignments and completion status."
    },
    "/communications/{communicationId}": {
      "schema": "AdminOperationalRecord",
      "description": "Communication history linked to clients, properties and operational work."
    },
    "/subscriptions/{subscriptionId}": {
      "schema": "AdminOperationalRecord",
      "description": "Client/property subscription and commercial arrangement records."
    },
    "/auditEvents/{eventId}": {
      "schema": "AdminAuditEvent",
      "description": "Server-written audit trail for privileged admin actions."
    }
  },
  "security": {
    "clientFirestoreAccess": "denied",
    "trustedServerAccess": "Firebase Admin SDK",
    "adminAuthentication": "Firebase Authentication ID token verified by Express server",
    "sensitiveAccessStorage": "AES-256-GCM encrypted bookingAccessSecrets collection; authenticated staff API only"
  }
}
