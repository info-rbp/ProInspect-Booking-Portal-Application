{
  "entities": {
    "Service": {
      "title": "Service",
      "description": "ProInspect bookable service configuration. Firestore is the runtime source of truth; defaults seed missing records only.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "publicDescription": {
          "type": "string",
          "maxLength": 500
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "residential",
              "commercial",
              "strata-building"
            ]
          },
          "minItems": 1
        },
        "duration": {
          "type": "number"
        },
        "bufferBefore": {
          "type": "number"
        },
        "bufferAfter": {
          "type": "number"
        },
        "minimumNoticeHours": {
          "type": "number"
        },
        "maxFutureBookingDays": {
          "type": "number"
        },
        "calendarId": {
          "type": "string",
          "maxLength": 256
        },
        "active": {
          "type": "boolean"
        },
        "publiclyBookable": {
          "type": "boolean"
        },
        "order": {
          "type": "number"
        },
        "iconName": {
          "type": "string",
          "maxLength": 64
        },
        "badge": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": [
        "name",
        "categories",
        "duration",
        "active",
        "publiclyBookable"
      ]
    },
