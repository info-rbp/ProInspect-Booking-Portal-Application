{
  "entities": {
    "Service": {
      "title": "Service",
      "description": "ProInspect bookable service configuration. Firestore is the runtime source of truth; defaults seed missing records only.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "publicDescription": {
          "type": "string",
          "maxLength": 500
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["residential", "commercial", "strata-building"]
          },
          "minItems": 1
        },
        "duration": {
          "type": "number"
        },
        "bufferBefore": {
          "type": "number"
        },
        "bufferAfter": {
          "type": "number"
        },
        "minimumNoticeHours": {
          "type": "number"
        },
        "maxFutureBookingDays": {
          "type": "number"
        },
        "calendarId": {
          "type": "string",
          "maxLength": 256
        },
        "active": {
          "type": "boolean"
        },
        "publiclyBookable": {
          "type": "boolean"
        },
        "order": {
          "type": "number"
        },
        "iconName": {
          "type": "string",
          "maxLength": 64
        },
        "badge": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": [
        "name",
        "categories",
        "duration",
        "active",
        "publiclyBookable"
      ]
    },
    "Booking": {
      "title": "Booking",
      "description": "Persistent booking/work-order record created by the trusted server API.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "bookingReference": {
          "type": "string",
          "maxLength": 32
        },
        "managementToken": {
          "type": "string",
          "maxLength": 128
        },
        "serviceId": {
          "type": "string",
          "maxLength": 64
        },
        "serviceName": {
          "type": "string",
          "maxLength": 100
        },
        "serviceCategory": {
          "type": "string",
          "enum": ["residential", "commercial", "strata-building"]
        },
        "clientUid": {
          "type": "string",
          "maxLength": 128
        },
        "propertyId": {
          "type": "string",
          "maxLength": 128
        },
        "calendarEventId": {
          "type": "string",
          "maxLength": 256
        },
        "calendarHtmlLink": {
          "type": "string",
          "maxLength": 1000
        },
        "property": {
          "type": "object"
        },
        "access": {
          "type": "object"
        },
        "appointment": {
          "type": "object"
        },
        "status": {
          "type": "string",
          "enum": [
            "confirmed",
            "completed",
            "cancelled"
          ]
        },
        "adminNotes": {
          "type": "string",
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string",
          "maxLength": 50
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 50
        },
        "readinessStatus": {
          "type": "string",
          "enum": [
            "ready",
            "pending_notice",
            "access_action_required"
          ]
        },
        "confirmationEmail": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "bookingReference",
        "managementToken",
        "serviceId",
        "serviceName",
        "serviceCategory",
        "property",
        "access",
        "appointment",
        "readinessStatus",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "ClientUser": {
      "title": "ClientUser",
      "description": "Authenticated ProInspect client profile keyed by Firebase UID.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 120 },
        "displayName": { "type": "string", "maxLength": 150 },
        "organisationName": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 50 },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["uid", "email", "displayName", "active", "createdAt", "updatedAt"]
    },
    "ClientProperty": {
      "title": "ClientProperty",
      "description": "Persistent client property record created from linked bookings and reused by the Client Portal.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "clientUid": { "type": "string", "maxLength": 128 },
        "clientEmail": { "type": "string", "maxLength": 120 },
        "streetAddress": { "type": "string", "maxLength": 150 },
        "unit": { "type": "string", "maxLength": 50 },
        "suburb": { "type": "string", "maxLength": 100 },
        "state": { "type": "string", "maxLength": 10 },
        "postcode": { "type": "string", "maxLength": 10 },
        "propertyType": { "type": "string", "maxLength": 100 },
        "categories": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 },
        "lastBookingAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "clientUid", "clientEmail", "streetAddress", "suburb", "state", "postcode", "propertyType", "categories", "createdAt", "updatedAt"]
    },
    "ClientRequest": {
      "title": "ClientRequest",
      "description": "Future-facing request record for document, maintenance and operational workflows.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "clientUid": { "type": "string", "maxLength": 128 },
        "propertyId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["document", "maintenance", "general"] },
        "title": { "type": "string", "maxLength": 200 },
        "status": { "type": "string", "enum": ["submitted", "in_progress", "waiting_client", "completed", "cancelled"] },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "clientUid", "type", "title", "status", "createdAt", "updatedAt"]
    },
    "ClientDocument": {
      "title": "ClientDocument",
      "description": "Client-visible metadata for reports, leases, notices and other property documents.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "clientUid": { "type": "string", "maxLength": 128 },
        "propertyId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 250 },
        "documentType": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["available", "draft", "archived"] },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "clientUid", "name", "documentType", "status", "createdAt", "updatedAt"]
    },
    "Settings": {
      "title": "Settings",
      "description": "ProInspect scheduling and operating configuration stored at settings/business.",
      "type": "object",
      "properties": {
        "timezone": {
          "type": "string",
          "maxLength": 50
        },
        "locale": {
          "type": "string",
          "maxLength": 20
        },
        "operatingHours": {
          "type": "object"
        },
        "minimumNoticeHours": {
          "type": "number"
        },
        "maxFutureBookingDays": {
          "type": "number"
        },
        "calendarConnected": {
          "type": "boolean"
        },
        "calendarEmail": {
          "type": "string",
          "maxLength": 256
        }
      },
      "required": [
        "timezone",
        "locale",
        "operatingHours"
      ]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Optional Firebase UID based administrator allow-list entry.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "maxLength": 50
        },
        "active": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "maxLength": 50
        }
      },
      "required": [
        "email"
      ]
    },
    "ScheduleLock": {
      "title": "ScheduleLock",
      "description": "Short-lived internal Firestore lock used to prevent concurrent booking confirmations from reserving overlapping times.",
      "type": "object",
      "properties": {
        "bookingId": {
          "type": "string",
          "maxLength": 128
        },
        "expiresAt": {
          "type": "string",
          "maxLength": 50
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 50
        }
      },
      "required": [
        "bookingId",
        "expiresAt",
        "updatedAt"
      ]
    },
    "BookingAccessSecret": {
      "title": "BookingAccessSecret",
      "description": "AES-256-GCM encrypted lockbox/alarm payload stored separately from the normal booking record. Server-only and decrypted only for authenticated staff responses.",
      "type": "object",
      "properties": {
        "version": {
          "type": "number"
        },
        "algorithm": {
          "type": "string",
          "enum": [
            "aes-256-gcm"
          ]
        },
        "keyId": {
          "type": "string",
          "maxLength": 100
        },
        "iv": {
          "type": "string",
          "maxLength": 100
        },
        "authTag": {
          "type": "string",
          "maxLength": 100
        },
        "ciphertext": {
          "type": "string",
          "maxLength": 10000
        },
        "createdAt": {
          "type": "string",
          "maxLength": 50
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 50
        }
      },
      "required": [
        "version",
        "algorithm",
        "keyId",
        "iv",
        "authTag",
        "ciphertext",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/services/{serviceId}": {
      "schema": "Service",
      "description": "Inspection and field-service definitions used by the booking engine."
    },
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Persistent customer bookings and internal work orders."
    },
    "/clientUsers/{firebaseUid}": {
      "schema": "ClientUser",
      "description": "Verified client identity and profile record."
    },
    "/clientProperties/{propertyId}": {
      "schema": "ClientProperty",
      "description": "Properties linked to authenticated client accounts."
    },
    "/clientRequests/{requestId}": {
      "schema": "ClientRequest",
      "description": "Client request records used by future document and property-operation workflows."
    },
    "/clientDocuments/{documentId}": {
      "schema": "ClientDocument",
      "description": "Client-visible document metadata; file storage is handled separately."
    },
    "/settings/business": {
      "schema": "Settings",
      "description": "Single business scheduling configuration record."
    },
    "/adminUsers/{firebaseUid}": {
      "schema": "AdminUser",
      "description": "Optional Firebase UID based administrator allow-list."
    },
    "/scheduleLocks/{lockId}": {
      "schema": "ScheduleLock",
      "description": "Internal transient concurrency locks. Server-only; never exposed to the browser."
    },
    "/bookingAccessSecrets/{bookingId}": {
      "schema": "BookingAccessSecret",
      "description": "Encrypted sensitive property-access credentials. Server-only; never exposed through public booking APIs or Google Calendar."
    }
  },
  "security": {
    "clientFirestoreAccess": "denied",
    "trustedServerAccess": "Firebase Admin SDK",
    "adminAuthentication": "Firebase Authentication ID token verified by Express server",
    "sensitiveAccessStorage": "AES-256-GCM encrypted bookingAccessSecrets collection; authenticated staff API only"
  }
}
