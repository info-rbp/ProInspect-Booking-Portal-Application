{
  "entities": {
    "Service": {
      "title": "Service",
      "description": "ProInspect bookable service configuration. Firestore is the runtime source of truth; defaults seed missing records only.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "publicDescription": {
          "type": "string",
          "maxLength": 500
        },
        "duration": {
          "type": "number"
        },
        "bufferBefore": {
          "type": "number"
        },
        "bufferAfter": {
          "type": "number"
        },
        "minimumNoticeHours": {
          "type": "number"
        },
        "maxFutureBookingDays": {
          "type": "number"
        },
        "calendarId": {
          "type": "string",
          "maxLength": 256
        },
        "active": {
          "type": "boolean"
        },
        "publiclyBookable": {
          "type": "boolean"
        },
        "order": {
          "type": "number"
        },
        "iconName": {
          "type": "string",
          "maxLength": 64
        },
        "badge": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": [
        "name",
        "duration",
        "active",
        "publiclyBookable"
      ]
    },
    "Booking": {
      "title": "Booking",
      "description": "Persistent booking/work-order record created by the trusted server API.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "bookingReference": {
          "type": "string",
          "maxLength": 32
        },
        "managementToken": {
          "type": "string",
          "maxLength": 128
        },
        "serviceId": {
          "type": "string",
          "maxLength": 64
        },
        "serviceName": {
          "type": "string",
          "maxLength": 100
        },
        "calendarEventId": {
          "type": "string",
          "maxLength": 256
        },
        "calendarHtmlLink": {
          "type": "string",
          "maxLength": 1000
        },
        "property": {
          "type": "object"
        },
        "access": {
          "type": "object"
        },
        "appointment": {
          "type": "object"
        },
        "status": {
          "type": "string",
          "enum": [
            "confirmed",
            "completed",
            "cancelled"
          ]
        },
        "adminNotes": {
          "type": "string",
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string",
          "maxLength": 50
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 50
        },
        "readinessStatus": {
          "type": "string",
          "enum": [
            "ready",
            "pending_notice",
            "access_action_required"
          ]
        },
        "confirmationEmail": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "bookingReference",
        "managementToken",
        "serviceId",
        "serviceName",
        "property",
        "access",
        "appointment",
        "readinessStatus",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "Settings": {
      "title": "Settings",
      "description": "ProInspect scheduling and operating configuration stored at settings/business.",
      "type": "object",
      "properties": {
        "timezone": {
          "type": "string",
          "maxLength": 50
        },
        "locale": {
          "type": "string",
          "maxLength": 20
        },
        "operatingHours": {
          "type": "object"
        },
        "minimumNoticeHours": {
          "type": "number"
        },
        "maxFutureBookingDays": {
          "type": "number"
        },
        "calendarConnected": {
          "type": "boolean"
        },
        "calendarEmail": {
          "type": "string",
          "maxLength": 256
        }
      },
      "required": [
        "timezone",
        "locale",
        "operatingHours"
      ]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Optional Firebase UID based administrator allow-list entry.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "maxLength": 50
        },
        "active": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "maxLength": 50
        }
      },
      "required": [
        "email"
      ]
    },
    "ScheduleLock": {
      "title": "ScheduleLock",
      "description": "Short-lived internal Firestore lock used to prevent concurrent booking confirmations from reserving overlapping times.",
      "type": "object",
      "properties": {
        "bookingId": {
          "type": "string",
          "maxLength": 128
        },
        "expiresAt": {
          "type": "string",
          "maxLength": 50
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 50
        }
      },
      "required": [
        "bookingId",
        "expiresAt",
        "updatedAt"
      ]
    },
    "BookingAccessSecret": {
      "title": "BookingAccessSecret",
      "description": "AES-256-GCM encrypted lockbox/alarm payload stored separately from the normal booking record. Server-only and decrypted only for authenticated staff responses.",
      "type": "object",
      "properties": {
        "version": {
          "type": "number"
        },
        "algorithm": {
          "type": "string",
          "enum": [
            "aes-256-gcm"
          ]
        },
        "keyId": {
          "type": "string",
          "maxLength": 100
        },
        "iv": {
          "type": "string",
          "maxLength": 100
        },
        "authTag": {
          "type": "string",
          "maxLength": 100
        },
        "ciphertext": {
          "type": "string",
          "maxLength": 10000
        },
        "createdAt": {
          "type": "string",
          "maxLength": 50
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 50
        }
      },
      "required": [
        "version",
        "algorithm",
        "keyId",
        "iv",
        "authTag",
        "ciphertext",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/services/{serviceId}": {
      "schema": "Service",
      "description": "Inspection and field-service definitions used by the booking engine."
    },
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Persistent customer bookings and internal work orders."
    },
    "/settings/business": {
      "schema": "Settings",
      "description": "Single business scheduling configuration record."
    },
    "/adminUsers/{firebaseUid}": {
      "schema": "AdminUser",
      "description": "Optional Firebase UID based administrator allow-list."
    },
    "/scheduleLocks/{lockId}": {
      "schema": "ScheduleLock",
      "description": "Internal transient concurrency locks. Server-only; never exposed to the browser."
    },
    "/bookingAccessSecrets/{bookingId}": {
      "schema": "BookingAccessSecret",
      "description": "Encrypted sensitive property-access credentials. Server-only; never exposed through public booking APIs or Google Calendar."
    }
  },
  "security": {
    "clientFirestoreAccess": "denied",
    "trustedServerAccess": "Firebase Admin SDK",
    "adminAuthentication": "Firebase Authentication ID token verified by Express server",
    "sensitiveAccessStorage": "AES-256-GCM encrypted bookingAccessSecrets collection; authenticated staff API only"
  }
}
