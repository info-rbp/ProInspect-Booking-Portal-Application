{
  "entities": {
    "Service": {
      "title": "Service",
      "description": "ProInspect inspection service configuration",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 100 },
        "publicDescription": { "type": "string", "maxLength": 500 },
        "duration": { "type": "number" },
        "bufferBefore": { "type": "number" },
        "bufferAfter": { "type": "number" },
        "minimumNoticeHours": { "type": "number" },
        "maxFutureBookingDays": { "type": "number" },
        "calendarId": { "type": "string", "maxLength": 128 },
        "active": { "type": "boolean" },
        "publiclyBookable": { "type": "boolean" },
        "order": { "type": "number" }
      },
      "required": ["name", "duration", "active"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Property inspection booking and work order record",
      "type": "object",
      "properties": {
        "bookingReference": { "type": "string", "maxLength": 32 },
        "managementToken": { "type": "string", "maxLength": 64 },
        "serviceId": { "type": "string", "maxLength": 64 },
        "serviceName": { "type": "string", "maxLength": 100 },
        "calendarEventId": { "type": "string", "maxLength": 128 },
        "propertyStreet": { "type": "string", "maxLength": 150 },
        "propertyUnit": { "type": "string", "maxLength": 50 },
        "suburb": { "type": "string", "maxLength": 100 },
        "state": { "type": "string", "maxLength": 10 },
        "postcode": { "type": "string", "maxLength": 10 },
        "fullAddress": { "type": "string", "maxLength": 300 },
        "propertyType": { "type": "string", "maxLength": 50 },
        "clientName": { "type": "string", "maxLength": 100 },
        "clientReference": { "type": "string", "maxLength": 100 },
        "customerName": { "type": "string", "maxLength": 100 },
        "customerEmail": { "type": "string", "maxLength": 120 },
        "customerPhone": { "type": "string", "maxLength": 50 },
        "accessMethod": { "type": "string", "maxLength": 50 },
        "accessDetails": { "type": "object" },
        "tenantDetails": { "type": "object" },
        "specialInstructions": { "type": "string", "maxLength": 1000 },
        "appointmentStart": { "type": "string", "maxLength": 50 },
        "appointmentEnd": { "type": "string", "maxLength": 50 },
        "timezone": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["confirmed", "completed", "cancelled"] },
        "adminNotes": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["bookingReference", "serviceName", "customerEmail", "status", "appointmentStart"]
    },
    "Settings": {
      "title": "Settings",
      "description": "ProInspect global operating and scheduling settings",
      "type": "object",
      "properties": {
        "timezone": { "type": "string", "maxLength": 50 },
        "locale": { "type": "string", "maxLength": 20 },
        "operatingHours": { "type": "object" },
        "minimumNoticeHours": { "type": "number" },
        "maxFutureBookingDays": { "type": "number" },
        "defaultCalendarId": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["timezone", "locale"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized administrator profile",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/services/{serviceId}": {
      "schema": "Service",
      "description": "Inspection services available for booking"
    },
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "All customer bookings and work orders"
    },
    "/settings/{settingId}": {
      "schema": "Settings",
      "description": "Operating hours, timezone and configuration"
    },
    "/adminUsers/{adminId}": {
      "schema": "AdminUser",
      "description": "Administrator allowlist entries"
    }
  }
}
