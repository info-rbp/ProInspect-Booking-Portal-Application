rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // The booking portal uses the trusted server API for all Firestore access.
    // Firebase Authentication is used by the browser only to obtain an ID token
    // that the server verifies before allowing administrator operations.
    //
    // Keeping direct browser access closed prevents public enumeration of:
    // - bookings and tenant contact information
    // - lockbox / key / alarm access details
    // - administrator notes
    // - service and scheduling configuration writes
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
